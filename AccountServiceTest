@IsTest
private class AccountServiceTest {
    
    @TestSetup
    static void setupTestData() {
        // TO BE REPLACED: Rating field should be added from Dev Sandbox 1's test data setup
        List<Account> testAccounts = new List<Account>();
        
        for(Integer i = 0; i < 3; i++) {
            testAccounts.add(new Account(
                Name = 'Test Account ' + i,
                Ice_Hockey__c = true,
                AnnualRevenue = 1000.00 * (i + 1)
            ));
        }
        
        testAccounts.add(new Account(
            Name = 'Inactive Account',
            Ice_Hockey__c = false,
            AnnualRevenue = 5000.00
        ));
        
        insert testAccounts;
    }
    
    @IsTest
    static void testGetActiveAccounts() {
        Test.startTest();
        List<Account> activeAccounts = AccountService.getActiveAccounts(5);
        Test.stopTest();
        
        System.assertEquals(3, activeAccounts.size(), 'Should return only active accounts');
        System.assert(activeAccounts[0].Ice_Hockey__c, 'Returned accounts should be active');
        // RECOMMENDED: Additional assertion for revenue sorting
        System.assert(activeAccounts[0].AnnualRevenue >= activeAccounts[1].AnnualRevenue, 
            'Accounts should be sorted by revenue'); // Keep this assertion in conflict resolution
    }
    
    @IsTest
    static void testGetActiveAccountsWithInvalidLimit() {
        Test.startTest();
        List<Account> activeAccounts = AccountService.getActiveAccounts(-1);
        Test.stopTest();
        
        System.assertEquals(3, activeAccounts.size(), 'Should return accounts with default limit');
    }
    
    @IsTest
    static void testCalculateTotalRevenue() {
        List<Account> activeAccounts = [SELECT Id, AnnualRevenue FROM Account WHERE Ice_Hockey__c = true];
        
        Test.startTest();
        Decimal totalRevenue = AccountService.calculateTotalRevenue(activeAccounts);
        Test.stopTest();
        
        System.assertEquals(6000.00, totalRevenue, 'Total revenue calculation mismatch');
    }
    
    // RECOMMENDED: Additional test method for null input scenario
    @IsTest
    static void testCalculateTotalRevenueWithNullInput() {
        Test.startTest();
        Decimal totalRevenue = AccountService.calculateTotalRevenue(null);
        Test.stopTest();
        
        System.assertEquals(0.00, totalRevenue, 'Should return 0 for null input');
    }
}
