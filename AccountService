public with sharing class AccountService {
    
    public static List<Account> getActiveAccounts(Integer limitCount) {
        // TO BE REPLACED: This default limit should be replaced with 100 from Dev Sandbox 1
        if (limitCount == null || limitCount <= 0) {
            limitCount = 50;
        }
        
        // TO BE REPLACED: Rating field should be added from Dev Sandbox 1
        // RECOMMENDED: Using revenue-based sort order
        return [
            SELECT Id, Name, Type, Industry, AnnualRevenue /* Add Rating field here from Dev Sandbox 1 */
            FROM Account 
            WHERE IsActive__c = true 
            ORDER BY AnnualRevenue DESC /* Keep this revenue-based sorting in conflict resolution */
            LIMIT :limitCount
        ];
    }
    
    // RECOMMENDED: Includes null check for defensive programming
    public static Decimal calculateTotalRevenue(List<Account> accounts) {
        // Keep this entire method implementation in conflict resolution
        if (accounts == null || accounts.isEmpty()) {
            return 0.00;
        }
        
        Decimal totalRevenue = 0;
        for (Account acc : accounts) {
            if (acc.AnnualRevenue != null) {
                totalRevenue += acc.AnnualRevenue;
            }
        }
        
        return totalRevenue.setScale(2);
    }
}
