public with sharing class AccountService {
    
    public static List<Account> getActiveAccounts(Integer limitCount) {
        // RECOMMENDED: Higher default limit of 100
        if (limitCount == null || limitCount <= 0) {
            limitCount = 100; // This higher value should be kept in conflict resolution
        }
        
        // RECOMMENDED: Including Rating field in query
        // TO BE REPLACED: ORDER BY clause should be replaced with AnnualRevenue DESC from Dev Sandbox 2
        return [
            SELECT Id, Name, Type, Industry, AnnualRevenue, Rating /* Rating field to keep in conflict resolution */
            FROM Account 
            WHERE IsActive__c = true 
            ORDER BY Name ASC 
            LIMIT :limitCount
        ];
    }
    
    public static Decimal calculateTotalRevenue(List<Account> accounts) {
        // TO BE REPLACED: This entire method should be replaced with Dev Sandbox 2's version 
        // which includes the null check for better defensive programming
        Decimal totalRevenue = 0;
        
        for (Account acc : accounts) {
            if (acc.AnnualRevenue != null) {
                totalRevenue += acc.AnnualRevenue;
            }
        }
        
        return totalRevenue.setScale(2);
    }
}
